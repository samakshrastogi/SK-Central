NODE_ENV=production
PORT=10000
TRUST_PROXY=1
CLIENT_ORIGIN=https://www.sk-hub.in
ALLOWED_ORIGINS=https://sk-hub.in,https://www.sk-hub.in,https://quiz.sk-hub.in,https://mailpilot.sk-hub.in
MONGODB_URI=mongodb+srv://USER:PASSWORD@CLUSTER.mongodb.net/?retryWrites=true&w=majority
DATABASE_NAME=central
JWT_SECRET=replace-with-64-character-random-secret
SSO_TOKEN_SECRET=replace-with-different-64-character-random-secret
SSO_COOKIE_NAME=sk_central_sid
SSO_SESSION_DAYS=3650
SSO_APP_TOKEN_MINUTES=10
MAIL_FROM=SK Central <hello@sk-hub.in>
RESEND_API_KEY=replace-with-resend-api-key
SMTP_HOST=smtpout.secureserver.net
SMTP_PORT=465
SMTP_TIMEOUT_MS=12000
SMTP_SECURE=true
SMTP_STARTTLS=false
SMTP_USER=hello@sk-hub.in
SMTP_PASS=replace-with-godaddy-email-password-or-app-password
OTP_TTL_MINUTES=10
REDIS_URL=rediss://default:PASSWORD@HOST:PORT
LOG_LEVEL=info
GEMINI_API_KEY=replace-with-production-gemini-api-key
GEMINI_MODEL=gemini-1.5-flash
SK_QUIZ_API_URL=https://your-sk-quiz-api.onrender.com/api
SK_QUIZ_SERVICE_TOKEN=replace-with-shared-service-token
SK_QUIZ_ADMIN_TOKEN=

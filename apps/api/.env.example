NODE_ENV=development
PORT=4002
TRUST_PROXY=false
CLIENT_ORIGIN=http://localhost:5475
ALLOWED_ORIGINS=http://localhost:5475,http://localhost:5474,http://localhost:5173
MONGODB_URI=mongodb://127.0.0.1:27017/sk-central
DATABASE_NAME=sk-central
JWT_SECRET=replace-when-auth-is-added
SSO_TOKEN_SECRET=replace-with-64-character-random-secret
SSO_COOKIE_NAME=sk_central_sid
SSO_SESSION_DAYS=3650
SSO_APP_TOKEN_MINUTES=10
MAIL_FROM=SK Central <hello@sk-hub.in>
RESEND_API_KEY=
SMTP_HOST=smtpout.secureserver.net
SMTP_PORT=465
SMTP_TIMEOUT_MS=12000
SMTP_SECURE=true
SMTP_STARTTLS=false
SMTP_USER=
SMTP_PASS=
OTP_TTL_MINUTES=10
REDIS_URL=redis://127.0.0.1:6379
LOG_LEVEL=info
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.5-flash
SK_QUIZ_API_URL=http://localhost:4001/api
SK_QUIZ_SERVICE_TOKEN=
